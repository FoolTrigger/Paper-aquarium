# ── Зависимости ───────────────────────────────────────────────────────────────
node_modules/

# ── Собранные бинарники и релизы ─────────────────────────────────────────────
dist/
runtime/
*.exe

# ── Данные пользователей (детские рисунки, имена, рыбы) ──────────────────────
