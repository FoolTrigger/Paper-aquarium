# но не должны заливаться в публичный репозиторий GitHub.
data/*
!data/tanks/
data/tanks/*
!data/tanks/.gitkeep
data/trash-tanks/
portable.txt

# ── Локальные настройки и логи ────────────────────────────────────────────────
.env
.env.local
*.log

